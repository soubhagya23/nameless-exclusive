# Copy to .env.local for local dev. On Vercel, add each of these under Project > Settings > Environment Variables.

# Supabase > Project Settings > API Keys (publishable key = ANON, secret key = SERVICE_ROLE)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transcription (OpenAI) and brief drafting (Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Who may log in to HQ. Comma separated.
HQ_ALLOWED_EMAILS=hello@thenameless.studio,ranjansoubhagya.master@gmail.com

# Hostnames. Middleware routes exclusive.* to client pages and hq.* to the dashboard.
CLIENT_HOST=exclusive.thenameless.studio
HQ_HOST=hq.thenameless.studio

# Secret used by HQ to call internal jobs (any long random string)
INTERNAL_SECRET=change-me-to-a-long-random-string
